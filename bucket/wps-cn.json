{
    "version": "12.1.0.25865",
    "description": "一站式办公服务平台 | Complete office suite with PDF editor",
    "homepage": "https://www.wps.cn/",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://official-package.wpscdn.cn/wps/download/WPS_Setup_25865.exe",
            "hash": "94ba7e304bb2b95b77023c7dc73808287b3771c83ba63c083f3e8a303a4d6cc5"
        }
    },
    "installer": {
        "script": [
            "& \"$dir\\WPS_Setup_25865.exe\" /S -agreelicense",
            "Start-Sleep -Seconds 30",
            "$office6 = Get-ChildItem \"$env:LocalAppData\\kingsoft\\WPS Office\" -Filter 'office6' -Recurse -Directory -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1 -ExpandProperty FullName",
            "if (!$office6) { throw 'WPS office6 directory not found after installation' }",
            "New-Item -ItemType Junction -Path \"$dir\\office6\" -Target $office6 -Force | Out-Null"
        ]
    },
    "pre_uninstall": [
        "$uninst = Get-ChildItem \"$env:LocalAppData\\kingsoft\\WPS Office\" -Filter 'uninst.exe' -Recurse -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1 -ExpandProperty FullName",
        "if ($uninst) { Start-Process $uninst -ArgumentList '/S' -Wait }"
    ],
    "bin": [
        ["office6\\wps.exe", "wps"],
        ["office6\\et.exe", "et"],
        ["office6\\wpp.exe", "wpp"],
        ["office6\\pdf.exe", "wpspdf"]
    ],
    "shortcuts": [
        ["office6\\wps.exe", "WPS Writer"],
        ["office6\\et.exe", "WPS Spreadsheets"],
        ["office6\\wpp.exe", "WPS Presentation"],
        ["office6\\pdf.exe", "WPS PDF"]
    ],
    "checkver": {
        "url": "https://official-package.wpscdn.cn/wps/download/",
        "regex": "WPS_Setup_([\\d]+)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://official-package.wpscdn.cn/wps/download/WPS_Setup_$version.exe"
            }
        }
    }
}
