{
    "version": "3.5.8",
    "description": "Extend your GitHub workflow beyond your browser.",
    "homepage": "https://desktop.github.com/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zetaloop/desktop/releases/download/release-3.5.8/GitHubDesktop-Windows-x64.exe",
            "hash": ""
        }
    },
    "installer": {
        "script": [
            "& \"$dir\\GitHubDesktop-Windows-x64.exe\" --silent --do-not-launch-app",
            "Start-Sleep -Seconds 15",
            "$src = Get-ChildItem \"$env:LOCALAPPDATA\\GitHubDesktop\" -Filter 'GitHubDesktop.exe' -Recurse | Sort-Object LastWriteTime -Descending | Select-Object -First 1 -ExpandProperty FullName",
            "if ($src) { Copy-Item $src \"$dir\\GitHubDesktop.exe\" -Force } else { throw 'GitHubDesktop.exe not found after install' }"
        ]
    },
    "bin": "GitHubDesktop.exe",
    "shortcuts": [
        [
            "GitHubDesktop.exe",
            "GitHub Desktop"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/zetaloop/desktop/tags",
        "regex": "tags/release-([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zetaloop/desktop/releases/download/release-$version/GitHubDesktop-Windows-x64.exe"
            }
        }
    }
}
