{
    "version": "2026.4.2",
    "description": "Burp Suite 是 PortSwigger 公司开发的集成化 Web 应用安全测试平台，以拦截代理为核心，集成了抓包、扫描、攻击和扩展等功能模块，广泛应用于渗透测试与漏洞挖掘。",
    "homepage": "https://portswigger.net/",
    "license": "Proprietary",
    "notes": [
        "安装后更新会调用本地 manifest.json 内容进行更新",
        "需要自行注册，方法请参考文件-使用说明.txt"
    ],
    "url": "https://portswigger.net/burp/releases/download?product=pro&type=Jar&version=2026.4.2",
    "hash": "2ebb4d68021ff372faacc442b7de215aca664b5842d2900a9e4361f3b7d2608c",
    "bin": [
        [
            "CN_Burp.bat",
            "Burpsuite"
        ]
    ],
    "pre_install": [
        "$burpDir = Join-Path $dir 'BurpSuite'",
        "$jar = Join-Path $dir 'burpsuite_pro.jar'",
        "if (Test-Path $jar) {",
        "    if (!(Test-Path $burpDir)) { New-Item -ItemType Directory -Path $burpDir | Out-Null }",
        "    Move-Item -Path $jar -Destination (Join-Path $burpDir 'burpsuite_pro.jar') -Force",
        "}"
    ],
    "checkver": {
        "url": "https://portswigger.net/burp/releases/data?pageSize=4",
        "jsonpath": "$.ResultSet.Results[0].version"
    },
    "autoupdate": {
        "url": "https://portswigger.net/burp/releases/download?product=pro&type=Jar&version=$version",
        "hash": {
            "mode": "json",
            "url": "https://portswigger.net/burp/releases/data?pageSize=4",
            "jp": "$.ResultSet.Results.[?(@.releaseChannels[0] == 'Stable' && @.title =~ /Professional.*/)].builds.[?(@.ProductId == 'pro' && @.ProductPlatform == 'Jar')].Md5Checksum"
        }
    }
}
