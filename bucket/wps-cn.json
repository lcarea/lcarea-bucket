{
    "version": "12.1.0.25865",
    "description": "一站式办公服务平台 | Complete office suite with PDF editor",
    "homepage": "https://www.wps.cn/",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://official-package.wpscdn.cn/wps/download/WPS_Setup_25865.exe",
            "hash": "94ba7e304bb2b95b77023c7dc73808287b3771c83ba63c083f3e8a303a4d6cc5"
        }
    },
    "installer": {
        "script": [
            "Start-Process -FilePath \"$dir\\$fname\" -ArgumentList '/S', '-agreelicense' -Wait",
            "$wpsRoot = \"$env:LocalAppData\\kingsoft\\WPS Office\"",
            "Start-Sleep -Seconds 3",
            "$office6 = Get-ChildItem $wpsRoot -Filter 'office6' -Recurse -Directory -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1 -ExpandProperty FullName",
            "if (!$office6) { throw 'WPS office6 directory not found after installation' }",
            "Set-Content -Path \"$dir\\wps-path.txt\" -Value $office6"
        ]
    },
    "pre_uninstall": [
        "$wpsRoot = \"$env:LocalAppData\\kingsoft\\WPS Office\"",
        "$uninst = Get-ChildItem $wpsRoot -Filter 'uninst.exe' -Recurse -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1 -ExpandProperty FullName",
        "if ($uninst) { Start-Process $uninst -ArgumentList '/S' -Wait }"
    ],
    "env_add_path": "%LocalAppData%\\kingsoft\\WPS Office\\*\\office6",
    "checkver": {
        "url": "https://official-package.wpscdn.cn/wps/download/",
        "regex": "WPS_Setup_([\\d]+)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://official-package.wpscdn.cn/wps/download/WPS_Setup_$version.exe"
            }
        }
    }
}
