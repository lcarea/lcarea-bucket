{
    "version": "24.09",
    "description": "A multi-format file archiver with high compression ratios.",
    "homepage": "https://www.7-zip.org",
    "license": {
        "identifier": "BSD-2-Clause, BSD-3-Clause, LGPL-2.1-or-later",
        "url": "https://www.7-zip.org/license.txt"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.7-zip.org/a/7z2409-x64.exe",
            "hash": ""
        },
        "32bit": {
            "url": "https://www.7-zip.org/a/7z2409.exe",
            "hash": ""
        },
        "arm64": {
            "url": "https://www.7-zip.org/a/7z2409-arm64.exe",
            "hash": ""
        }
    },
    "installer": {
        "script": [
            "$7zr = Join-Path $env:TMP '7zr.exe'",
            "Invoke-WebRequest https://www.7-zip.org/a/7zr.exe -OutFile $7zr",
            "Invoke-ExternalCommand $7zr @('x', \"$dir\\$fname\", \"-o$dir\", '-y') | Out-Null",
            "Remove-Item \"$dir\\Uninstall.exe\", \"$dir\\$fname\", $7zr -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        "7z.exe",
        "7zG.exe",
        "7zFM.exe"
    ],
    "shortcuts": [
        [
            "7zFM.exe",
            "7-Zip"
        ]
    ],
    "checkver": {
        "url": "https://www.7-zip.org/download.html",
        "regex": "Download 7-Zip ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://www.7-zip.org/a/7z$cleanVersion-x64.exe"
            },
            "32bit": {
                "url": "https://www.7-zip.org/a/7z$cleanVersion.exe"
            },
            "arm64": {
                "url": "https://www.7-zip.org/a/7z$cleanVersion-arm64.exe"
            }
        }
    }
}
