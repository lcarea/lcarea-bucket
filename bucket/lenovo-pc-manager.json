    "hash": "0791aa2c229be81739527f356291a0d6b2bbcc6eab6d2cc928eefcbdfdbb6679",
    "installer": {
        "script": [
            "$ErrorActionPreference = 'Continue'",
            "Expand-7zipArchive \"$dir\\$fname\" \"$dir\" -Removal",
            "$exes = Get-ChildItem \"$dir\" -Recurse -Filter '*.exe' | Where-Object { $_.Name -notlike 'unins*' }",
            "if ($exes) {",
            "    $mainExe = $exes | Where-Object { $_.Name -match 'Lenovo.*Manager|LenovoPC|PCManager' -and $_.Length -gt 1MB } | Sort-Object Length -Descending | Select-Object -First 1",
            "    if (!$mainExe) { $mainExe = $exes | Sort-Object Length -Descending | Select-Object -First 1 }",
            "    if ($mainExe) {",
            "        Write-Host \"主程序: $($mainExe.Name)\" -ForegroundColor Green",
            "    }",
            "}"
        ]
    },
    "shortcuts": [
        [
            "LenovoPCManager.exe",
            "联想电脑管家"
        ]
    ],
    "uninstaller": {
        "script": [
            "$uninst = Get-ChildItem \"$dir\" -Recurse -Filter 'unins*.exe' | Select-Object -First 1",
            "if ($uninst) {",
            "    Start-Process -FilePath $uninst.FullName -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART' -Wait -NoNewWindow",
            "}"
        ]
    },
    "checkver": {
        "url": "https://guanjia.lenovo.com.cn/",
        "regex": "版本号[：:]\\s*([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://guanjia-fast.lenovo.com.cn/download/lenovopcmanager_apps.exe"
    }
}
